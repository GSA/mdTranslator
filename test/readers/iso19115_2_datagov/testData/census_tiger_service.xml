                        <gmd:URL>https://tigerweb.geo.census.gov/arcgis/rest/services/Census2010/Urban/MapServer</gmd:URL>
                     </gmd:linkage>
                     <gmd:protocol>
                        <gco:CharacterString> HTTP/1.1</gco:CharacterString>
                     </gmd:protocol>
                     <gmd:name gco:nilReason="unknown"/>
                  </gmd:CI_OnlineResource>
               </srv:connectPoint>
            </srv:SV_OperationMetadata>
         </srv:containsOperations>
